---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title: string;
  description: string;
  mermaid?: boolean;
  progress?: boolean;
}
const { title, description, mermaid = false, progress = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'home' ? 'Niranga Niluminda · Software Engineer' : `${title} · Niranga Niluminda`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#070a12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
        if (location.search.indexOf('static') === -1) document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <div class="bg-fx" aria-hidden="true"></div>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap">
        <a class="logo" href="/"><span class="logo-mark">NN</span><span>Niranga</span></a>
        <nav class="nav-links" aria-label="Main">
          <a href="/#work">Work</a>
          <a class="hide-sm" href="/#about">About</a>
          <a class="hide-sm" href="/#journey">Journey</a>
          <a class="hide-sm" href="/#certificates">Certificates</a>
          <a href="/#contact">Contact</a>
          <button class="icon-btn" id="theme" type="button" aria-label="Toggle light and dark theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {person.fullName} · Built with Astro, deployed by GitHub Actions</span>
        <span>
          <a href={person.github}>GitHub</a> · <a href={person.linkedin}>LinkedIn</a> ·
          <a href="https://github.com/NirangaNiluminda/NirangaNiluminda.github.io">Source</a>
        </span>
      </div>
    </footer>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = document.documentElement;

      // theme toggle
      document.getElementById('theme')?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // scroll reveal
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // cursor glow on cards
      document.querySelectorAll<HTMLElement>('.glow').forEach((el) => {
        el.addEventListener('pointermove', (ev) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
          el.style.setProperty('--my', `${ev.clientY - r.top}px`);
        });
      });

      // rotating role words
      const rot = document.querySelector('.rotator');
      if (rot) {
        const items = [...rot.children];
        let i = 0;
        if (!reduce) setInterval(() => { items[i].classList.remove('on'); i = (i + 1) % items.length; items[i].classList.add('on'); }, 2400);
      }

      // count-up stats
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const cio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement; cio.unobserve(el);
          const end = parseFloat(el.dataset.count || '0'); const dec = parseInt(el.dataset.decimals || '0', 10);
          if (reduce) { el.textContent = end.toFixed(dec); continue; }
          const t0 = performance.now(); const dur = 1400;
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur); const v = end * (1 - Math.pow(1 - p, 3));
            el.textContent = v.toFixed(dec); if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.4 });
      counters.forEach((c) => cio.observe(c));

      // project filter
      const fbtns = document.querySelectorAll<HTMLButtonElement>('.filters button');
      fbtns.forEach((b) => b.addEventListener('click', () => {
        fbtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const cat = b.dataset.cat;
        document.querySelectorAll<HTMLElement>('[data-cats]').forEach((card) => {
          card.hidden = cat !== 'All' && !(card.dataset.cats || '').split('|').includes(cat || '');
        });
      }));

      // reading progress + active TOC link
      const bar = document.querySelector<HTMLElement>('.progress');
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      if (bar || tocLinks.length) {
        const sections = tocLinks.map((a) => document.querySelector(a.getAttribute('href') || '')).filter(Boolean) as HTMLElement[];
        const onScroll = () => {
          const h = document.documentElement.scrollHeight - innerHeight;
          if (bar) bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`;
          let cur = 0; sections.forEach((s, idx) => { if (s.getBoundingClientRect().top < 140) cur = idx; });
          tocLinks.forEach((a, idx) => a.classList.toggle('active', idx === cur));
        };
        addEventListener('scroll', onScroll, { passive: true }); onScroll();
      }
    </script>

    {mermaid && (
      <script is:inline type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs';
        const light = document.documentElement.getAttribute('data-theme') === 'light';
        mermaid.initialize({
          startOnLoad: false, securityLevel: 'strict', theme: 'base',
          themeVariables: light
            ? { primaryColor: '#eef1f8', primaryTextColor: '#0f172a', primaryBorderColor: '#7c3aed', lineColor: '#0891b2', fontFamily: 'Inter, sans-serif', fontSize: '14px' }
            : { primaryColor: '#121a2e', primaryTextColor: '#eef0f6', primaryBorderColor: '#8b5cf6', lineColor: '#22d3ee', secondaryColor: '#0b1020', tertiaryColor: '#0b1020', fontFamily: 'Inter, sans-serif', fontSize: '14px', noteBkgColor: '#121a2e', noteTextColor: '#eef0f6', actorBkg: '#121a2e', actorTextColor: '#eef0f6', actorBorder: '#8b5cf6', signalColor: '#22d3ee', signalTextColor: '#eef0f6', labelBoxBkgColor: '#121a2e', labelTextColor: '#eef0f6', edgeLabelBackground: '#0b1020' },
        });
        await mermaid.run({ querySelector: 'pre.mermaid' });
      </script>
    )}
  </body>
</html>
